# Quran Foundation API Configuration
# Copy this file to .env and fill in your actual API credentials
# DO NOT commit the .env file to version control

# OAuth2 Credentials (from https://api-docs.quran.foundation/request-access/)
QURAN_CLIENT_ID=your_client_id_here
QURAN_CLIENT_SECRET=your_client_secret_here

# Environment: "production" or "prelive"
QURAN_ENVIRONMENT=production

# Local OAuth redirect port (must match your registered redirect_uri)
OAUTH_REDIRECT_PORT=8765

# Feature Flags
# USE_FOUNDATION_CONTENT_API: Use Quran.Foundation Content API for verse data
USE_FOUNDATION_CONTENT_API=true
# USE_OFFLINE_FALLBACK: Allow fallback to offline Al-Quran Cloud data
USE_OFFLINE_FALLBACK=true